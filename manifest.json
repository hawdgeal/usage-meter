{
  "manifest_version": 3,
  "name": "Usage Meter for ChatGPT & Claude",
  "short_name": "Usage Meter",
  "version": "0.5.4",
  "description": "Shows your ChatGPT / Codex and Claude plan usage, credits and limits in each site's sidebar, with settings you can copy between them.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "claude-usage.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Usage Meter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "page-hook-chatgpt.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude-usage.js",
        "page-hook-claude.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-usage-meter@alencar.fr",
      "strict_min_version": "128.0"
    }
  }
}
