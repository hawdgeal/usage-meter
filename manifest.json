{
  "manifest_version": 3,
  "name": "Claude Usage Meter",
  "short_name": "Claude Usage",
  "version": "0.1.1",
  "description": "Shows your Claude plan limits (5-hour, weekly, per-model) and extra usage in the claude.ai and Claude Code on the web sidebar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage-meter@alencar.fr",
      "strict_min_version": "128.0"
    }
  }
}
